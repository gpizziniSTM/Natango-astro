---
import Layout from '../layouts/Layout.astro';

const isSeptemberCampaign = Astro.url.searchParams.get('offerta') === 'settembre';
const whatsappMessage = isSeptemberCampaign
  ? 'Ciao, ho inviato la richiesta per il corso principianti assoluti del lunedì e vorrei aggiungere un’informazione.'
  : 'Ciao, ho inviato la richiesta per la lezione di prova e vorrei aggiungere un’informazione.';
const whatsappUrl = `https://wa.me/393392737619?text=${encodeURIComponent(whatsappMessage)}`;
---

<Layout
  title="Richiesta ricevuta | Accademia Natango"
  description="La richiesta è stata inviata correttamente. Accademia Natango ti ricontatterà al più presto."
>
  <main class="confirmation-page">
    <section class="confirmation-card">
      <span class="confirmation-icon" aria-hidden="true"><i class="fas fa-check"></i></span>
      <p class="eyebrow">Richiesta inviata</p>
      <h1>Abbiamo ricevuto i tuoi dati.</h1>
      <p class="lead">
        {isSeptemberCampaign
          ? 'Ti ricontatteremo per concordare la prima lezione utile del corso del lunedì.'
          : 'Ti ricontatteremo per concordare giorno e orario della lezione di prova gratuita.'}
      </p>
      <div class="details">
        <div><i class="fas fa-location-dot"></i><span><strong>Tango Loft</strong>Via del Mandrione 109, Roma</span></div>
        {isSeptemberCampaign && <div><i class="fas fa-clock"></i><span><strong>Lunedì 20:00–21:00</strong>Inserimenti aperti anche a corso avviato</span></div>}
      </div>
      <div class="actions">
        <a class="btn btn-red" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><i class="fab fa-whatsapp"></i> Scrivici su WhatsApp</a>
        <a class="secondary-link" href="/">Torna al sito</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .confirmation-page { min-height: 100vh; display: grid; place-items: center; padding: 9rem 1.5rem 5rem; background: radial-gradient(circle at 50% 25%, rgba(6,147,227,.18), transparent 34%), #0a0a0a; }
  .confirmation-card { width: min(720px, 100%); padding: clamp(2rem, 6vw, 4.5rem); text-align: center; background: #15151a; border: 1px solid rgba(255,255,255,.12); border-radius: 24px; box-shadow: 0 30px 90px rgba(0,0,0,.42); }
  .confirmation-icon { display: grid; place-items: center; width: 76px; height: 76px; margin: 0 auto 1.5rem; color: #07141b; background: #72cdfd; border-radius: 50%; font-size: 2rem; }
  .eyebrow { color: #8fd7fd; font-size: .8rem; font-weight: 800; text-transform: uppercase; letter-spacing: .12em; }
  h1 { margin: .65rem 0 1rem; font-size: clamp(2.2rem, 6vw, 4rem); letter-spacing: -.045em; }
  .lead { max-width: 580px; margin: 0 auto; color: #b7b7be; font-size: 1.08rem; line-height: 1.7; }
  .details { display: grid; gap: .8rem; margin: 2rem 0; text-align: left; }
  .details div { display: grid; grid-template-columns: 42px 1fr; gap: .8rem; align-items: center; padding: 1rem; background: rgba(255,255,255,.035); border-radius: 12px; }
  .details i { color: #72cdfd; text-align: center; }
  .details strong, .details span { display: block; }
  .details span { color: #a9a9b0; font-size: .85rem; }
  .details strong { color: #fff; font-size: .96rem; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 1.2rem; }
  .actions .btn { display: inline-flex; align-items: center; gap: .7rem; padding: .95rem 1.25rem; border-radius: 8px; font-weight: 800; }
  .secondary-link { color: #8fd7fd; font-weight: 700; }
</style>
